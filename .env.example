# Bayse Markets API Configuration Example
# Copy this file to .env and configure your keys.
BAYSE_PUBLIC_KEY=pk_live_placeholder
BAYSE_SECRET_KEY=sk_live_placeholder

BASE_REST_URL=https://relay.bayse.markets
PUBLIC_WS_URL=wss://socket.bayse.markets/ws/v1/markets
PRIVATE_WS_URL=wss://socket.bayse.markets/ws/v1/user

# True = paper trading/simulation, False = live execution
DRY_RUN=True
